        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    direction LR\n\n    sys_user {\n        BIGINT id PK\n        VARCHAR(32) username UK\n        VARCHAR(100) password \&quot;BCrypt加密\&quot;\n        VARCHAR(32) real_name\n        VARCHAR(20) role_code \&quot;RoleCodeEnum:STUDENT/COUNSELOR/HR/COLLEGE_ADMIN\&quot;\n        VARCHAR(64) college\n        VARCHAR(64) major\n        VARCHAR(16) grade\n        VARCHAR(16) education\n        VARCHAR(255) skills\n        VARCHAR(255) job_intention\n        TINYINT status \&quot;1启用0停用\&quot;\n        TINYINT deleted \&quot;逻辑删除\&quot;\n    }\n\n    resume {\n        BIGINT id PK\n        BIGINT userId FK \&quot;指向sys_user.id,角色STUDENT\&quot;\n    }\n    job_post {\n        BIGINT id PK\n        BIGINT publisherId FK \&quot;HR/COUNSELOR/COLLEGE_ADMIN\&quot;\n    }\n    job_application {\n        BIGINT id PK\n        BIGINT studentId FK \&quot;指向sys_user.id\&quot;\n    }\n    internship_apply {\n        BIGINT id PK\n        BIGINT studentId FK\n        BIGINT mentorId FK \&quot;角色HR\&quot;\n        BIGINT teacherId FK \&quot;角色COUNSELOR\&quot;\n    }\n    internship_log {\n        BIGINT id PK\n        BIGINT studentId FK \&quot;指向sys_user.id\&quot;\n    }\n    interview_session {\n        BIGINT id PK\n        BIGINT studentId FK \&quot;指向sys_user.id\&quot;\n    }\n    policy_item {\n        BIGINT id PK\n    }\n\n    sys_user ||--o{ resume : \&quot;拥有简历\&quot;\n    sys_user ||--o{ job_post : \&quot;发布岗位\&quot;\n    sys_user ||--o{ job_application : \&quot;投递岗位\&quot;\n    sys_user ||--o{ internship_apply : \&quot;申请/审批\&quot;\n    sys_user ||--o{ internship_log : \&quot;提交日志\&quot;\n    sys_user ||--o{ interview_session : \&quot;面试训练\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="eoGCINaB1I-6gYf7wlhB-1">
