        </mxCell>
        <mxCell id="rule-6" value="6. 实习结束后三方评分：SelfScore(20%) + MentorScore(40%) + TeacherScore(40%) → FinalScore" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;spacingLeft=5;" vertex="1" parent="1">
