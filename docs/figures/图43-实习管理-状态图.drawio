        </mxCell>
        <mxCell id="rule-2" value="2. COUNSELOR_REVIEW：通过 → COLLEGE_REVIEW；驳回 → MENTOR_REVIEW（节点回退）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;spacingLeft=5;" vertex="1" parent="1">
