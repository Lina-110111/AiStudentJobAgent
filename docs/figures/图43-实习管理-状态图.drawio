        <mxCell id="rule-1" value="1. MENTOR_REVIEW：通过 → COUNSELOR_REVIEW；驳回 → REJECTED（首节点直接终止）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;spacingLeft=5;" vertex="1" parent="1">
