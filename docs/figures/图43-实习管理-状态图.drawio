        </mxCell>
        <mxCell id="rule-5" value="5. 每次流转追加 FlowTraceJson：{操作人, 动作, 节点, 意见, 时间}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;spacingLeft=5;" vertex="1" parent="1">
