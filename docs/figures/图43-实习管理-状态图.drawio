          <mxGeometry x="425" y="734" width="760" height="18" as="geometry" />
        </mxCell>
        <mxCell id="rule-4" value="4. PASSED / REJECTED 为终止状态，流程结束后不可再审批" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;spacingLeft=5;" vertex="1" parent="1">
