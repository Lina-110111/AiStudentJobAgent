# 复制为 .env 后按需修改（.env 不应提交到仓库）

# ---- 数据库 ----
DB_NAME=job_agent
DB_PORT=3306
DB_PASSWORD=root123456

# ---- Redis ----
REDIS_PORT=6379

# ---- 服务端口 ----
BACKEND_PORT=8080
FRONTEND_PORT=8081

# ---- JWT 密钥（生产环境必须修改，长度不少于 32 字节）----
JWT_SECRET=job-agent-course-design-secret-key-2024-please-change-me

# ---- 大模型（不配置时自动使用本地规则引擎，功能仍可完整演示）----
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
# 本地 Ollama 示例：
# AI_ENABLED=true
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434
# AI_MODEL=qwen2.5:7b
# AI_API_KEY=
